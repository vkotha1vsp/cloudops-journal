# Copy to infra/ec2-compose/.env on the instance (chmod 600).
APP_DOMAIN=learn.example.com
ACME_EMAIL=you@example.com
ALLOWED_EMAILS=you@example.com

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
NEXTAUTH_SECRET=

# Cognito app client (see docs/03-DEPLOYMENT.md, Option A step 3)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX

AWS_REGION=us-east-1
# Private bucket; the instance profile grants access (no keys here)
S3_ATTACHMENTS_BUCKET=
MAX_UPLOAD_MB=25

# Nightly backups (backup.sh)
BACKUP_BUCKET=

# Optional AI assistant. bedrock uses the instance role (add infra/console/iam/5-optional-bedrock-policy.json).
AI_PROVIDER=none
BEDROCK_MODEL_ID=
BEDROCK_REGION=
