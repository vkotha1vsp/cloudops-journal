aws_region        = "us-east-1"
hosted_zone_name  = "example.com"        # an existing Route 53 public hosted zone you own
app_subdomain     = "learn"              # → https://learn.example.com
admin_email       = "you@example.com"    # the only login; Cognito emails a temporary password
alarm_email       = "you@example.com"
github_repository = "vkotha1vsp/cloudops-journal"
instance_type     = "t3.small"
