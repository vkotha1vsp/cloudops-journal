# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://cloudops:cloudops@localhost:5432/cloudops?schema=public

# ── Auth (NextAuth) ───────────────────────────────────────
# Public URL of the app. Locally http://localhost:3000; in AWS https://learn.<your-domain>
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Only these emails may sign in (comma-separated). Single-admin by default.
ALLOWED_EMAILS=you@example.com

# Amazon Cognito (production). Leave blank locally and use the dev login below.
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
# e.g. https://cognito-idp.us-east-1.amazonaws.com/us-east-1_AbCdEf123
COGNITO_ISSUER=

# Local-only email/password login. NEVER enable in AWS.
AUTH_DEV_LOGIN=true
AUTH_DEV_PASSWORD=local-dev-only

# ── Storage ───────────────────────────────────────────────
AWS_REGION=us-east-1
# Private bucket for attachments. Leave blank locally to disable uploads.
S3_ATTACHMENTS_BUCKET=
MAX_UPLOAD_MB=25

# ── Optional AI assistant ─────────────────────────────────
# none | bedrock | openai. Keys stay server-side; the browser never sees them.
AI_PROVIDER=none
# e.g. an Anthropic Claude model or inference profile ID enabled in Bedrock for your account
BEDROCK_MODEL_ID=
BEDROCK_REGION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_DAILY_LIMIT=100

# ── Seed ──────────────────────────────────────────────────
SEED_ADMIN_EMAIL=you@example.com
SEED_ADMIN_NAME=Admin
